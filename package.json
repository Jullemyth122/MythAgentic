{
  "name": "mythagentic",
  "version": "0.1.0",
  "private": true,
  "description": "MythAgentic: tells a business where an AI agent pays off on its website, what kind, and where none should go. An open agentic website for the Open Agentic Web Challenge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "scan": "node scripts/scan-local.mjs",
    "serve:clinic": "node vendor/agentify-website/scripts/serve_site.mjs test-sites/clinic --port 8091",
    "serve:shop": "node vendor/agentify-website/scripts/serve_site.mjs test-sites/shop --port 8092",
    "serve:clear": "node vendor/agentify-website/scripts/serve_site.mjs test-sites/clear --port 8093"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15"
  }
}
